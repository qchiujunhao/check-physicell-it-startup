# Galaxy connection — provide API key OR username/password
GALAXY_BASE_URL=https://usegalaxy.org
GALAXY_API_KEY=
GALAXY_USERNAME=
GALAXY_PASSWORD=

# PhysiCell tool ID on Galaxy
PHYSICELL_TOOL_ID=toolshed.g2.bx.psu.edu/repos/rheiland/physicell_studio/interactive_tool_pcstudio/0.7
PHYSICELL_TOOL_VERSION_POLICY=latest

# Public preflight checks
PREFLIGHT_ENABLED=true
PREFLIGHT_TIMEOUT_SECONDS=15
GALAXY_STATUSPAGE_SUMMARY_URL=https://galaxyproject.statuspage.io/api/v2/summary.json

# Monitoring settings
STARTUP_TIMEOUT_SECONDS=600
STARTUP_EXPECTED_SECONDS=120
PURGE_REUSED_HISTORY=false
HISTORY_NAME=PhysiCell Monitor
OUTPUT_DIR=output

# Scheduled cleanup: only cancel jobs older than this many minutes, so the
# daily sweep never kills a monitor run that is still in flight.
CLEANUP_MIN_AGE_MINUTES=60

# Authenticated UI verification (logs in and confirms the tool UI renders).
# Requires GALAXY_USERNAME and GALAXY_PASSWORD above (API key alone cannot
# create the browser session the interactive-tool proxy needs).
REQUIRE_UI_VERIFICATION=true
UI_VERIFY_TIMEOUT_SECONDS=60
GALAXY_LOGIN_TIMEOUT_SECONDS=30

# Per-run Slack notification (posts on every run: ok, slow, or fail).
# Preferred: a bot token + channel ID, which attaches the run screenshot.
# The bot needs chat:write and files:write scopes and must be invited to the
# channel. Falls back to the webhook (text only) if the bot token is unset.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=
# Slack member ID (U...) to @-mention only when a run fails. Leave empty to
# never mention. Not secret; in GitHub, set it as a repository variable.
SLACK_MENTION_USER_ID=

# Optional escalation alerting (pages only after repeated failures).
# Leave MONITOR_ALERT_WEBHOOK_URL empty to disable and avoid double messages.
MONITOR_ALERT_WEBHOOK_URL=
ALERT_FAILURE_THRESHOLD=2
ALERT_IMMEDIATE_STAGES=authentication,tool_not_available
ALERT_COUNT_STATUSES=fail
ALERT_REPEAT_EVERY=0
